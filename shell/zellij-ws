#!/bin/sh
# Create, rename and remove jj workspaces / git worktrees from the command line,
# each in its own zellij session, the way the sidebar's Alt w / Alt W dialogs do.
# Meant for scripts and coding agents; the VCS work is the plugin's own ws.sh.
#
# @wsSh@ and @jq@ are filled in by the Nix build.
set -eu

ws_sh=@wsSh@
jq=@jq@
# the plugin's default `separator`: sessions are named project:workspace
sep=:
ht=$(printf '\t')

usage() {
  cat <<'EOF'
Usage: zellij-ws COMMAND [ARGS]    (run inside a jj or git repository)

  list                      workspaces of the repository except the main checkout,
                            one "<name><TAB><root>" line each
  status [NAME]             "<name><TAB><state><TAB><root>" for each workspace (or just
                            NAME); state: working, needs-input, done (finished, not
                            looked at since), open (session running, nothing to report)
                            or closed (no session). Needs zellij
  new NAME [-- COMMAND...]  create workspace NAME next to the main checkout, or reopen
                            an existing one, and start its session in the background
                            running COMMAND (default: a shell); prints the workspace root
  rename [OLD] NEW          rename workspace OLD (default: the current one) and its
                            session; prints the workspace root
  close NAME                remove workspace NAME and end its session; jj keeps its work
                            under bookmark NAME, git refuses if the worktree is dirty

Sessions are started, renamed and ended only inside zellij ($ZELLIJ set).
EOF
}

die() {
  echo "zellij-ws: $*" >&2
  exit 1
}

ws() {
  sh "$ws_sh" "$@"
}

in_zellij() {
  [ -n "${ZELLIJ:-}" ]
}

# session name of workspace $1, like the plugin's (session names cannot contain /)
session_of() {
  printf %s "$project$sep$1" | tr / -
}

# workspace directory name for a requested name, like the plugin's dialog
slug() {
  s=$(printf %s "$1" | tr / -)
  case $s in
  "" | .*) die "invalid workspace name: $1" ;;
  esac
  printf %s "$s"
}

# root of workspace $1 (never the main checkout), empty if there is none
root_of() {
  ws "$root" list | awk -F '\t' -v n="$1" '$1 == n { print $2; exit }'
}

# tabs of session $1 as JSON
session_tabs() {
  zellij -s "$1" action list-tabs --json
}

# whether session $1 is running (inside zellij, `zellij -s` with an unknown
# session succeeds after printing the session list)
is_live() {
  zellij list-sessions --no-formatting 2>/dev/null |
    awk -v p="$1 [Created " 'index($0, p) == 1 && !/\(EXITED/ { found = 1 } END { exit !found }'
}

[ $# -ge 1 ] || {
  usage >&2
  exit 2
}
cmd=$1
shift
case $cmd in
-h | --help | help)
  usage
  exit 0
  ;;
esac

info=$(ws "$PWD" info) || die "not in a jj or git repository: $PWD"
IFS=$ht read -r vcs main root current project <<EOF
$info
EOF

case $cmd in
list)
  [ $# -eq 0 ] || die "usage: zellij-ws list"
  ws "$root" list
  ;;

status)
  [ $# -le 1 ] || die "usage: zellij-ws status [NAME]"
  in_zellij || die "status needs zellij"
  only=
  [ $# -eq 0 ] || only=$(slug "$1")
  out=$(ws "$root" list | while IFS=$ht read -r name dir; do
    [ -z "$only" ] || [ "$name" = "$only" ] || continue
    # the sidebar keeps an agent's state as a marker on its tab's name; the
    # session reports its most urgent one
    session=$(session_of "$name")
    if is_live "$session"; then
      state=$(session_tabs "$session" | "$jq" -r '
        map(.name) as $n
        | if any($n[]; endswith(" ⏳")) then "needs-input"
          elif any($n[]; endswith(" ⚙")) then "working"
          elif any($n[]; endswith(" ✅")) then "done"
          else "open" end')
    else
      state=closed
    fi
    printf '%s\t%s\t%s\n' "$name" "$state" "$dir"
  done)
  [ -z "$only" ] || [ -n "$out" ] || die "no workspace $only in $project"
  [ -z "$out" ] || printf '%s\n' "$out"
  ;;

new)
  [ $# -ge 1 ] || die "usage: zellij-ws new NAME [-- COMMAND...]"
  name=$1
  shift
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || die "usage: zellij-ws new NAME [-- COMMAND...]"
    shift
    [ $# -gt 0 ] || die "missing COMMAND after --"
    in_zellij || die "running a COMMAND needs zellij"
  fi
  s=$(slug "$name")
  session=$(session_of "$s")
  open=
  if in_zellij && is_live "$session"; then
    open=1
    [ $# -eq 0 ] || die "workspace $s is already open in session $session, not starting $1 in it"
  fi
  dir=$(root_of "$s")
  if [ -z "$dir" ]; then
    dir=$main.ws/$s
    ws "$root" add "$vcs" "$dir" "$name" >&2
  fi
  if in_zellij; then
    if [ -n "$open" ]; then
      echo "zellij-ws: $session is already open" >&2
    elif [ $# -gt 0 ]; then
      # a new session starts in the directory it is created from
      (cd "$dir" && zellij attach --create-background "$session" -- "$@") >/dev/null
    else
      (cd "$dir" && zellij attach --create-background "$session") >/dev/null
    fi
  fi
  printf '%s\n' "$dir"
  ;;

rename)
  case $# in
  1)
    [ "$root" != "$main" ] || die "$root is the main checkout of $project, not renaming it"
    old=$current
    dir=$root
    new=$1
    ;;
  2)
    old=$(slug "$1")
    dir=$(root_of "$old")
    [ -n "$dir" ] || die "no workspace $old in $project"
    new=$2
    ;;
  *) die "usage: zellij-ws rename [OLD] NEW" ;;
  esac
  s=$(slug "$new")
  [ "$s" != "$old" ] || die "workspace is already named $s"
  [ -z "$(root_of "$s")" ] || die "workspace $s already exists in $project"
  # run from the main checkout: a git worktree moves away under its own cwd
  dir=$(ws "$main" rename "$vcs" "$dir" "$old" "$new")
  if in_zellij && is_live "$(session_of "$old")"; then
    zellij -s "$(session_of "$old")" action rename-session "$(session_of "$s")"
  fi
  printf '%s\n' "$dir"
  ;;

close)
  [ $# -eq 1 ] || die "usage: zellij-ws close NAME"
  s=$(slug "$1")
  dir=$(root_of "$s")
  [ -n "$dir" ] || die "no workspace $s in $project (the main checkout is never removed)"
  case "$(pwd -P)/" in
  "$dir"/*) die "$PWD is inside workspace $s; close it from another workspace" ;;
  esac
  session=$(session_of "$s")
  [ "${ZELLIJ_SESSION_NAME:-}" != "$session" ] ||
    die "this shell runs in session $session; close it from another session"
  # run from the main checkout: the workspace directory is deleted
  ws "$main" remove "$vcs" "$dir" "$s" >&2
  if in_zellij && is_live "$session"; then
    zellij kill-session "$session" >/dev/null
  fi
  ;;

*)
  usage >&2
  exit 2
  ;;
esac
